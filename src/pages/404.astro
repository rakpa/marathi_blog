---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="पान सापडलं नाही" noindex={true}>
  <section class="wrap nf">
    <p class="nf__code">४०४</p>
    <h1 class="nf__title">अरेरे, हे पान सापडलं नाही</h1>
    <p class="nf__text">
      तुम्ही शोधत असलेलं पान हटवलं असेल किंवा त्याचा पत्ता बदलला असेल.
      काळजी नको — खाली परत वाटेवर येऊ.
    </p>
    <div class="nf__actions">
      <a href="/" class="btn btn-primary">मुख्यपृष्ठावर जा</a>
      <a href="/search" class="btn btn-ghost">लेख शोधा</a>
    </div>
  </section>
</BaseLayout>

<style>
  .nf { text-align: center; padding-block: var(--space-3xl); max-width: 56ch; }
  .nf__code { font-family: var(--font-display); font-size: var(--step-5); color: var(--brand); line-height: 1; }
  .nf__title { font-size: var(--step-3); margin-block: var(--space-s); }
  .nf__text { color: var(--text-soft); margin-bottom: var(--space-l); }
  .nf__actions { display: flex; gap: 0.8rem; justify-content: center; flex-wrap: wrap; }
</style>

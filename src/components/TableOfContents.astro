---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}
// Only h2s drive the contents — keeps it scannable.
const items = Astro.props.headings.filter((h) => h.depth === 2);
---

{
  items.length > 1 && (
    <nav class="toc" aria-label="लेखातील विभाग">
      <p class="toc__title">या लेखात</p>
      <ol class="toc__list">
        {items.map((h) => (
          <li>
            <a href={`#${h.slug}`} class="toc__link" data-toc={h.slug}>
              {h.text}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

<script>
  // Highlight the section currently in view.
  const links = document.querySelectorAll<HTMLAnchorElement>('.toc__link');
  if (links.length) {
    const map = new Map<string, HTMLAnchorElement>();
    links.forEach((l) => map.set(l.dataset.toc!, l));
    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            links.forEach((l) => l.classList.remove('is-active'));
            map.get(e.target.id)?.classList.add('is-active');
          }
        });
      },
      { rootMargin: '-20% 0px -70% 0px' },
    );
    document.querySelectorAll('.prose h2[id]').forEach((h) => obs.observe(h));
  }
</script>

<style>
  .toc {
    position: sticky; top: 90px;
    font-family: var(--font-ui);
  }
  .toc__title {
    font-size: var(--step--1); font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.08em; color: var(--text-mute); margin-bottom: 0.8rem;
  }
  .toc__list { list-style: none; padding: 0; display: grid; gap: 0.55rem; border-inline-start: 2px solid var(--border); }
  .toc__link {
    display: block; padding-inline-start: 0.9rem; margin-inline-start: -2px;
    border-inline-start: 2px solid transparent; color: var(--text-mute);
    text-decoration: none; font-size: var(--step--1); line-height: 1.4;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .toc__link:hover { color: var(--text); }
  .toc__link.is-active { color: var(--brand); border-inline-start-color: var(--brand); font-weight: 600; }
</style>

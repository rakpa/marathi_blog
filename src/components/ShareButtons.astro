---
import { icon } from '@/lib/icons';

interface Props {
  title: string;
  /** Absolute URL of the article. */
  url: string;
}
const { title, url } = Astro.props;
const text = encodeURIComponent(title);
const u = encodeURIComponent(url);

// WhatsApp first — the dominant share channel for Marathi readers.
const links = [
  { name: 'WhatsApp', href: `https://wa.me/?text=${text}%20${u}`, icon: 'whatsapp' },
  { name: 'X', href: `https://twitter.com/intent/tweet?text=${text}&url=${u}`, icon: 'x' },
  { name: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${u}`, icon: 'facebook' },
];
---

<div class="share" aria-label="हा लेख शेअर करा">
  <span class="share__label">शेअर करा</span>
  <div class="share__row">
    {
      links.map((l) => (
        <a
          class={`share__btn share__btn--${l.icon}`}
          href={l.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${l.name} वर शेअर करा`}
        >
          <Fragment set:html={icon(l.icon)} />
        </a>
      ))
    }
    <button class="share__btn share__btn--copy" data-copy={url} aria-label="लिंक कॉपी करा">
      <Fragment set:html={icon('link')} />
      <span class="share__copied" hidden>कॉपी झालं!</span>
    </button>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('.share__btn--copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const url = btn.dataset.copy;
      if (!url) return;
      try {
        await navigator.clipboard.writeText(url);
        const toast = btn.querySelector('.share__copied');
        if (toast) {
          toast.hidden = false;
          setTimeout(() => (toast.hidden = true), 1600);
        }
      } catch {}
    });
  });
</script>

<style>
  .share { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; }
  .share__label {
    font-family: var(--font-ui); font-weight: 600;
    font-size: var(--step--1); color: var(--text-mute);
  }
  .share__row { display: flex; gap: 0.5rem; align-items: center; }
  .share__btn {
    display: inline-flex; align-items: center; gap: 0.4rem;
    width: 42px; height: 42px; justify-content: center;
    border-radius: var(--radius-full); border: 1px solid var(--border);
    background: var(--surface); color: var(--text-soft); cursor: pointer;
    transition: transform 0.15s ease, background 0.2s ease, color 0.2s ease;
  }
  .share__btn:hover { transform: translateY(-2px); }
  .share__btn--whatsapp:hover { background: #25d366; color: #fff; border-color: #25d366; }
  .share__btn--x:hover { background: #111; color: #fff; border-color: #111; }
  .share__btn--facebook:hover { background: #1877f2; color: #fff; border-color: #1877f2; }
  .share__btn--copy { width: auto; padding-inline: 0.9rem; }
  .share__copied { font-family: var(--font-ui); font-size: var(--step--1); }
  .share__btn svg { width: 20px; height: 20px; }
</style>
